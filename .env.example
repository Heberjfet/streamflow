# ──────────────────────────────────────────────
# StreamFlow — Variables de Entorno
# Copiá este archivo:  cp .env.example .env
# ──────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────
POSTGRES_USER=streamflow
POSTGRES_PASSWORD=streamflow
POSTGRES_DB=streamflow
DATABASE_URL=postgresql://streamflow:streamflow@postgres:5432/streamflow

# ── Redis (BullMQ) ─────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ────────────────────────────────────────
# CAMBIAR en producción (secreto largo y aleatorio)
JWT_SECRET=change-this-in-production

# ── Admin Bootstrap (Opcional) ─────────────────
# Si se definen, se crea automáticamente un usuario admin en el arranque.
# Si se dejan vacíos, el primer usuario que se registre vía web será admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── S3 (SeaweedFS) ─────────────────────────────
# Las credenciales deben coincidir con docker/seaweedfs-s3.json
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://s3:8333
S3_BUCKET=streamflow

# URLs públicas de S3 — proxyadas por nginx para evitar mixed content
S3_PUBLIC_URL=http://localhost:9000
S3_BROWSER_ENDPOINT=http://localhost:9000

# ── CORS ───────────────────────────────────────
# Orígenes permitidos separados por coma (ej. http://localhost:3000,http://10.31.32.125:3000)
# En desarrollo/LAN las IPs privadas y localhost se admiten automáticamente.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── API ────────────────────────────────────────
PORT=3001

# ── Frontend ───────────────────────────────────
# Dejar vacío en local/LAN para autodetección dinámica en el navegador (host:3001 y host:9000).
# O definir la URL explícita si se usa proxy inverso (/api) o dominio propio.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_S3_URL=

# ──────────────────────────────────────────────
# Ejemplo para PRODUCCIÓN (Cloudflare + dominio)
# ──────────────────────────────────────────────
# JWT_SECRET=<secreto-fuerte>
# POSTGRES_PASSWORD=<password-fuerte>
# MINIO_ROOT_PASSWORD=<password-fuerte>
# S3_PUBLIC_URL=https://flow.tudominio.com/s3
# S3_BROWSER_ENDPOINT=https://flow.tudominio.com/s3
# CORS_ORIGINS=https://flow.tudominio.com,http://flow.tudominio.com
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_S3_URL=https://flow.tudominio.com/s3
