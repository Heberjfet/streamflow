{
  "name": "streamflow-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de Video Self-Hosted para streaming personal",
  "workspaces": [
    "apps/*",
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=apps/api",
    "build:worker": "npm run build --workspace=worker",
    "build:frontend": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose --profile production down",
    "docker:logs": "docker compose logs -f",
    "streamflow:up": "docker compose up -d --build",
    "streamflow:down": "docker compose --profile production down",
    "streamflow:logs": "docker compose logs -f",
    "streamflow:reset": "docker compose --profile production down -v",
    "clean": "node -e \"const {rmSync}=require('node:fs'); for (const p of ['node_modules','apps/api/node_modules','worker/node_modules','frontend/node_modules']) rmSync(p,{recursive:true,force:true})\""
  },
  "keywords": [
    "video",
    "streaming",
    "hls",
    "self-hosted",
    "transcoding"
  ],
  "author": "HeberJFet",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/lib-storage": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0"
  }
}